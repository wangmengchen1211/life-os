# 数据库（本地 Docker PostgreSQL）
DATABASE_URL=postgresql://user:password@localhost:5432/lifeos

# 访问保护
# 使用 bcryptjs 生成的密码哈希
ACCESS_PASSWORD_HASH=

# Session 密钥（至少32字符）
SESSION_SECRET=

# AI - 通义千问（阿里云 DashScope）
# 申请地址: https://dashscope.console.aliyun.com/
DEEPSEEK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_KEY=

ANTHROPIC_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ANTHROPIC_API_KEY=

# AI 预算（单位：人民币/月）
AI_MONTHLY_BUDGET_CNY=50

# Cron 密钥
CRON_SECRET=

# 飞书开放平台（个人版/自建应用）—— 外部源单向导入用
# 创建应用：https://open.feishu.cn/app
# scope 至少包含：drive:drive:readonly、docx:document:readonly
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 回调地址，需在飞书应用后台「安全设置」→「重定向 URL」里配置
FEISHU_REDIRECT_URI=https://mindos.weirdwork.cn/api/feishu/oauth/callback
