      "        default: '${3:bg-primary text-primary-foreground}',",
      "        ghost: '${4:bg-transparent hover:bg-accent}',",
      "      },",
      "      size: {",
      "        sm: 'h-8 px-3',",
      "        md: 'h-10 px-4',",
      "        lg: 'h-12 px-6',",
      "      },",
      "    },",
      "    defaultVariants: { variant: 'default', size: 'md' },",
      "  },",
      ");",
      "",
      "export interface ${5:Component}Props",
      "  extends React.HTMLAttributes<HTMLDivElement>,",
      "    VariantProps<typeof ${1:component}Variants> {}",
