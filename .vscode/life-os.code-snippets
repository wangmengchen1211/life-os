      "  id: serial('id').primaryKey(),",
      "  userId: integer('user_id').notNull(),",
      "  ${2:title}: text('${2:title}').notNull(),",
      "  createdAt: timestamp('created_at').defaultNow().notNull(),",
      "  updatedAt: timestamp('updated_at').defaultNow().notNull(),",
      "});",
      "",
      "export type ${3:TableRow} = typeof ${1:tableName}.\\$inferSelect;",
      "export type New${3:TableRow} = typeof ${1:tableName}.\\$inferInsert;"
    ],
    "description": "Drizzle pgTable 骨架"
  },
